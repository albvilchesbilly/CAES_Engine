{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cae-engine/engine/esquema_capacidades.json",
  "title": "Matriz de perfiles y capacidades (contrato C13 de ADR-011)",
  "description": "Forma del fichero. Las reglas que cruzan campos (eventos del catalogo cerrado, un perfil que no esta a la vez en concede y en pendiente, una capacidad pendiente que declara su decision) las comprueba engine/capacidades.py al cargar: un JSON Schema no llega ahi.",
  "type": "object",
  "required": ["version_matriz", "ambitos", "superficies", "perfiles", "capacidades"],
  "additionalProperties": false,
  "properties": {
    "version_matriz": {"type": "string", "minLength": 1},
    "fuente": {"type": "string", "minLength": 1},
    "ambitos": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ambito"}},
    "superficies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/superficie"}},
    "perfiles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/perfil"}},
    "capacidades": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capacidad"}}
  },
  "$defs": {
    "identificador": {"type": "string", "minLength": 1},
    "lista_identificadores": {"type": "array", "items": {"$ref": "#/$defs/identificador"}},
    "ambito": {
      "type": "object",
      "required": ["id", "nombre", "exige_tenant", "bloques"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identificador"},
        "nombre": {"type": "string", "minLength": 1},
        "exige_tenant": {"type": "boolean"},
        "solo_actuaciones_propias": {"type": "boolean"},
        "bloques": {"$ref": "#/$defs/lista_identificadores"}
      }
    },
    "superficie": {
      "type": "object",
      "required": ["id", "nombre", "pantallas"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identificador"},
        "nombre": {"type": "string", "minLength": 1},
        "pantallas": {"type": "array", "items": {"$ref": "#/$defs/pantalla"}}
      }
    },
    "pantalla": {
      "type": "object",
      "required": ["id", "nombre", "perfil"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identificador"},
        "nombre": {"type": "string", "minLength": 1},
        "perfil": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "perfil": {
      "type": "object",
      "required": ["id", "nombre", "ambito", "superficie"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identificador"},
        "nombre": {"type": "string", "minLength": 1},
        "ambito": {"$ref": "#/$defs/identificador"},
        "superficie": {"$ref": "#/$defs/identificador"}
      }
    },
    "condicion": {
      "type": "object",
      "required": ["perfil", "requiere", "nota"],
      "additionalProperties": false,
      "properties": {
        "perfil": {"$ref": "#/$defs/identificador"},
        "requiere": {"$ref": "#/$defs/identificador"},
        "nota": {"type": "string", "minLength": 1}
      }
    },
    "capacidad": {
      "type": "object",
      "required": ["id", "nombre", "grupo", "tipo", "concede"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/identificador"},
        "nombre": {"type": "string", "minLength": 1},
        "grupo": {
          "type": "string",
          "enum": [
            "actuaciones",
            "actos",
            "gobierno_tenant",
            "externos",
            "gobierno_modelo",
            "operacion",
            "sistema"
          ]
        },
        "tipo": {"type": "string", "enum": ["comando", "lectura"]},
        "proceso": {"type": ["string", "null"], "minLength": 2},
        "eventos": {"$ref": "#/$defs/lista_identificadores"},
        "eventos_propuestos": {"$ref": "#/$defs/lista_identificadores"},
        "efecto": {"type": ["string", "null"], "minLength": 1},
        "exige_justificacion": {"type": "boolean"},
        "concede": {"$ref": "#/$defs/lista_identificadores"},
        "pendiente": {"$ref": "#/$defs/lista_identificadores"},
        "decide": {"type": ["string", "null"], "minLength": 1},
        "condicionada": {"type": "array", "items": {"$ref": "#/$defs/condicion"}},
        "bloques": {"$ref": "#/$defs/lista_identificadores"},
        "manejador": {"type": ["string", "null"], "minLength": 1},
        "falta": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
